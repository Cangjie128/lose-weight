NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 只允许服务端读取，不要添加 NEXT_PUBLIC_ 前缀。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_DAILY_USER_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=100
AI_MAX_OUTPUT_TOKENS=1200
# 备用服务默认关闭。只有明确启用并逐次确认才调用。
AI_ALLOW_OPENAI_FALLBACK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Connections are disabled until these server-only values are configured.
APP_ORIGIN=http://127.0.0.1:3004
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate 32 random bytes encoded as 64 hex characters. Never commit the value.
INTEGRATION_ENCRYPTION_KEY=
